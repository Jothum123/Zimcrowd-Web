{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "checkJs": false
  },
  "include": [
    "*.js",
    "js/**/*.js",
    "routes/**/*.js",
    "services/**/*.js",
    "middleware/**/*.js",
    "utils/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "dist",
    "build",
    ".git",
    "coverage"
  ]
}
